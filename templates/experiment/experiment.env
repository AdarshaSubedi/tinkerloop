# experiment.env — the ONLY file an experiment author edits. Sourced by run.sh. No logic here.
# Paths may be relative to this experiment folder (run.sh runs from it; outputs go to results/).

# WHAT this experiment tests (one line, plain words) and which angle it belongs to.
PURPOSE=""
ANGLE=""

# SETUP_CMD: run before smoke AND render (e.g. activate a virtualenv, `pip install -r reqs.txt`,
# download a small dataset). Must be safe to re-run. Leave empty if nothing is needed.
SETUP_CMD=""

# SMOKE_CMD: a CHEAP dry-run — load everything + do ~1 step on a tiny input. Proves the environment
# works before paying for the full run. Must exit non-zero on any failure.
SMOKE_CMD=""

# LAUNCH_CMD: the FULL run.
LAUNCH_CMD=""

# Resources, passed to `bin/tinker-run submit` (the direct runner ignores them; a queue uses them).
VRAM_GB=0            # GPU memory needed in GB; 0 = CPU only
CLASS="default"      # workload tag, e.g. cpu-script, llm-eval, image-gen

# --- OUTPUTS (read by the loop's experiment lifecycle, not by run.sh) --------------------------
# These decouple the human verdict from the exit code: the loop surfaces the best EXISTING artifact
# on ANY terminal state (done OR failed), so a run that dies in a late stage still earns a verdict.
# FINAL_ARTIFACT: the main output (path relative to results/).
FINAL_ARTIFACT=""
# EVAL_ARTIFACTS: ordered BEST→WORST globs (relative to results/) that are good enough for a verdict
# even if FINAL_ARTIFACT never appears. Set to "$FINAL_ARTIFACT" if there are no useful intermediates.
#   e.g. FINAL_ARTIFACT="report.md"   EVAL_ARTIFACTS="report.md partial_*.csv"
EVAL_ARTIFACTS=""
